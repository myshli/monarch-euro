[Unit]
Description=Daily Monarch import of European bank transactions

[Timer]
# Twice daily. Enable Banking's free tier allows four unattended polls per
# day, which is also the PSD2 ceiling, so this leaves headroom for retries.
OnCalendar=*-*-* 07:30
OnCalendar=*-*-* 19:30
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
