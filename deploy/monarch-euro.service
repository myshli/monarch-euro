[Unit]
Description=Sync European bank transactions into Monarch Money
After=network-online.target
Wants=network-online.target
# A crash before Python starts (bad venv, missing env file) never reaches the
# in-process notifier, so systemd reports those itself. This is a [Unit] key;
# placed under [Service] it is silently ignored.
OnFailure=monarch-euro-failure.service

[Service]
Type=oneshot
User=monarch
Group=monarch
WorkingDirectory=/opt/monarch-euro
Environment=STATE_DIR=/var/lib/monarch-euro
EnvironmentFile=/opt/monarch-euro/.env
ExecStart=/opt/monarch-euro/.venv/bin/monarch-euro sync

# The service handles bank credentials; keep it boxed in.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monarch-euro
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
