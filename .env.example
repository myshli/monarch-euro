# ---------------------------------------------------------------------------
# Enable Banking (source)
# Sign up at https://enablebanking.com/ -> Control Panel -> create application.
# Choose "Restricted Production" so you can link your own real accounts free.
# Registering the app produces a private key file; save it and point at it here.
# ---------------------------------------------------------------------------
EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# Must exactly match a redirect URL registered on the application.
# Nothing needs to listen on it - you copy the code out of the address bar.
EB_REDIRECT_URL=https://localhost/callback
EB_BASE_URL=https://api.enablebanking.com

# ---------------------------------------------------------------------------
# Wise (source, via Wise's own API - NOT Enable Banking)
# PSD2 open banking only reaches EEA-registered institutions, so a
# US-registered Wise profile is invisible to an AISP even when its EUR balance
# carries a Belgian IBAN. Wise's own API has no such boundary and sees every
# balance on the profile, USD included.
#
# Generate the token in Wise: Settings -> API tokens (needs 2-step login).
# ---------------------------------------------------------------------------
WISE_TOKEN=
# Only needed if Wise answers with an SCA challenge, which happens for EU/UK
# profiles. Run `monarch-euro wise-probe` to find out; it tells you plainly.
# Generate a keypair, upload the public half in Wise under
# Settings -> API tokens -> Manage public keys, point this at the private half.
WISE_PRIVATE_KEY_PATH=
# One Monarch account per Wise balance: CURRENCY|Monarch account name
# A USD balance needs its own account so it is never currency-converted.
# Pin the profile so a business profile on the same token can never be
# picked up by accident. `wise-probe` lists the ids.
WISE_PROFILE_ID=
WISE_ACCOUNTS=EUR|Wise EUR;USD|Wise USD

# ---------------------------------------------------------------------------
# Monarch (sink)
# MONARCH_MFA_SECRET is the TOTP *seed*, not a 6-digit code. Monarch shows it
# behind the QR image in Settings -> Security when you set up an authenticator.
# Storing the seed is what lets an unattended VPS run log in without you.
# ---------------------------------------------------------------------------
# Monarch answers programmatic password logins with CAPTCHA_REQUIRED, but the
# CAPTCHA only guards logging IN. Its web app authenticates every request with
# a session cookie plus a CSRF token, so reusing a session you established in a
# browser never touches the CAPTCHA at all.
#
# In Chrome on app.monarch.com:
#   DevTools -> Application -> Cookies -> https://app.monarch.com
#   copy the values of `sessionid` and `csrftoken`
#
# With these two set, no password, MFA seed or bearer token is needed, and the
# account password never has to exist on disk.
MONARCH_SESSION_COOKIE=
MONARCH_CSRF_TOKEN=

# Legacy bearer path, kept in case the login CAPTCHA is ever lifted.
MONARCH_TOKEN=
MONARCH_EMAIL=you@example.com
MONARCH_PASSWORD=
MONARCH_MFA_SECRET=

# ---------------------------------------------------------------------------
# Account mapping
# Format: key|ASPSP name|COUNTRY|Monarch account name
# Separate multiple entries with ';'. Get exact ASPSP names from:
#     monarch-euro banks --country DE
# ---------------------------------------------------------------------------
ACCOUNT_LINKS=n26|N26|DE|N26 Checking

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Monarch has no multi-currency support, so everything is converted to one
# currency at the ECB rate for each transaction's own booking date.
TARGET_CURRENCY=USD
FX_BASE_URL=https://api.frankfurter.dev/v1
# Record "EUR 42.00 @ 1.146 ECB 2026-09-18 = USD 48.13" in each note, so the
# conversion stays auditable and reversible.
NOTE_ORIGINAL_AMOUNT=true
# Re-fetch window. Overlap is deliberate: banks revise and late-post rows, and
# the dedupe ledger makes re-fetching free.
LOOKBACK_DAYS=30
# Pending transactions change amount and identity before they settle.
INCLUDE_PENDING=false
# Log what would be posted without writing to Monarch.
DRY_RUN=false

# ---------------------------------------------------------------------------
# Notifications
# On a timer-driven VPS a failed sync is silent: the first symptom is missing
# transactions weeks later. Both likely failures (a lapsed bank consent, an
# expired Monarch session) need a human within a day or two.
# Create a bot via @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_SUCCESS=false

STATE_DIR=./state
